// Shared build settings. Signing defaults to ad hoc ("Sign to Run Locally"), which needs
// no Apple account, but macOS treats every ad hoc build as a new app and asks for the permissions
// again. To sign with your Apple Developer team and keep them across rebuilds, copy
// Signing.xcconfig.example to Signing.xcconfig (gitignored) and fill it in.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none

// Never add the debugger entitlement (get-task-allow): Tallshot ships with no entitlements,
// and notarization rejects it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

#include? "Signing.xcconfig"
